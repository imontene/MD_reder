{
  "name": "@imontene/mdrender",
  "version": "1.0.0",
  "description": "Command-line app for Windows and Linux that renders Markdown — with LaTeX equations and Mermaid diagrams — to PDF and HTML using the Inter typeface",
  "keywords": [
    "markdown",
    "pdf",
    "html",
    "mermaid",
    "katex",
    "latex",
    "cli",
    "inter",
    "converter"
  ],
  "homepage": "https://github.com/imontene/MD_reder#readme",
  "bugs": {
    "url": "https://github.com/imontene/MD_reder/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imontene/MD_reder.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "mdrender": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "build:exe": "npm run build && node scripts/build-sea.mjs",
    "prepublishOnly": "npm run check && npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@puppeteer/browsers": "^3.2.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "highlight.js": "^11.12.0",
    "inter-ui": "^4.1.1",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.1.0",
    "puppeteer-core": "^25.12.0",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pdfjs-dist": "^6.4.299",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
